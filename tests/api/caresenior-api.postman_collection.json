{
  "info": {
    "name": "CareSenior API",
    "_postman_id": "caresenior-collection-001",
    "description": "Testes de API do sistema CareSenior — Disciplina de Teste de Software",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Teste 1 — POST /medicamentos (Particionamento de Equivalência)",
      "item": [
        {
          "name": "CT01 — Cadastro válido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Losartana\",\n  \"dosagem\": \"50mg\",\n  \"horario\": \"08:00\"\n}"
            },
            "url": { "raw": "http://localhost:3001/medicamentos", "host": ["localhost"], "port": "3001", "path": ["medicamentos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Resposta contém campo status\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('status');",
                  "});",
                  "pm.test(\"Status é sucesso\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('sucesso');",
                  "});",
                  "pm.test(\"Resposta contém dados do medicamento\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.dados).to.have.property('id');",
                  "    pm.expect(json.dados.nome).to.eql('Losartana');",
                  "});",
                  "// Salva o ID para reuso",
                  "var json = pm.response.json();",
                  "if (json.dados) pm.environment.set('medicamentoId', json.dados.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "CT02 — Nome ausente (inválido)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"\",\n  \"dosagem\": \"50mg\",\n  \"horario\": \"08:00\"\n}"
            },
            "url": { "raw": "http://localhost:3001/medicamentos", "host": ["localhost"], "port": "3001", "path": ["medicamentos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Mensagem de erro de nome\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.mensagem).to.eql('Nome do medicamento é obrigatório');",
                  "});",
                  "pm.test(\"Código de erro correto\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.codigoErro).to.eql('NOME_INVALIDO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CT03 — Horário inválido (fora do formato)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Atenolol\",\n  \"dosagem\": \"25mg\",\n  \"horario\": \"25:99\"\n}"
            },
            "url": { "raw": "http://localhost:3001/medicamentos", "host": ["localhost"], "port": "3001", "path": ["medicamentos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Mensagem de erro de horário\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.mensagem).to.include('Horário inválido');",
                  "});",
                  "pm.test(\"Código de erro correto\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.codigoErro).to.eql('HORARIO_INVALIDO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CT04 — Dosagem ausente (inválida)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Atenolol\",\n  \"dosagem\": \"\",\n  \"horario\": \"08:00\"\n}"
            },
            "url": { "raw": "http://localhost:3001/medicamentos", "host": ["localhost"], "port": "3001", "path": ["medicamentos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Mensagem de erro de dosagem\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.mensagem).to.eql('Dosagem é obrigatória');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Teste 2 — POST /doses (Análise de Valor Limite)",
      "item": [
        {
          "name": "Setup — Cadastrar medicamento para dose",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Rivotril\",\n  \"dosagem\": \"2mg\",\n  \"horario\": \"20:00\"\n}"
            },
            "url": { "raw": "http://localhost:3001/medicamentos", "host": ["localhost"], "port": "3001", "path": ["medicamentos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.dados) pm.environment.set('medicamentoIdDose', json.dados.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "CT01 — Registro de dose válido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicamentoId\": {{medicamentoIdDose}},\n  \"administradoPor\": \"Maria Silva\"\n}"
            },
            "url": { "raw": "http://localhost:3001/doses", "host": ["localhost"], "port": "3001", "path": ["doses"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Status é sucesso\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('sucesso');",
                  "});",
                  "pm.test(\"Dose contém campo administradoPor\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.dados.administradoPor).to.eql('Maria Silva');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CT02 — medicamentoId inválido (0 — abaixo do limite)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicamentoId\": 0,\n  \"administradoPor\": \"Maria Silva\"\n}"
            },
            "url": { "raw": "http://localhost:3001/doses", "host": ["localhost"], "port": "3001", "path": ["doses"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Medicamento não encontrado\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.codigoErro).to.eql('MEDICAMENTO_NAO_ENCONTRADO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CT03 — administradoPor ausente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicamentoId\": {{medicamentoIdDose}},\n  \"administradoPor\": \"\"\n}"
            },
            "url": { "raw": "http://localhost:3001/doses", "host": ["localhost"], "port": "3001", "path": ["doses"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Mensagem de erro de administrador\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.codigoErro).to.eql('ADMINISTRADO_POR_INVALIDO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CT04 — Data com formato inválido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicamentoId\": {{medicamentoIdDose}},\n  \"administradoPor\": \"João\",\n  \"data\": \"28-05-2026\"\n}"
            },
            "url": { "raw": "http://localhost:3001/doses", "host": ["localhost"], "port": "3001", "path": ["doses"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Código de erro de data\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.codigoErro).to.eql('DATA_INVALIDA');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET /status",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3001/status", "host": ["localhost"], "port": "3001", "path": ["status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"API está OK\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql('OK');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
